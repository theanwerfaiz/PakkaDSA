---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/header.css';
import '../styles/home.css';
import '../styles/viewer.css';
import '../styles/responsive.css';
import Icon from '../components/Icon.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { homePath, langPrefix, type Lang } from '../content/catalog';
import { ldJson, type JsonLd } from '../content/seo';
import { createHash } from 'node:crypto';
import themeInit from '../app/theme-init.js?raw';
import { t } from '../app/i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page without the language prefix, e.g. "/algorithms/bubble-sort/". */
  path: string;
  /** Open algorithm id, if this is an algorithm page. */
  current?: string | undefined;
  view: 'home' | 'viz' | 'page';
  jsonld?: JsonLd[];
  /** Open Graph image path, 1200 × 630. */
  og?: string;
  noindex?: boolean;
  /** Fonts this page needs first (its largest text), preloaded. */
  preload?: string[];
}
const {
  lang,
  title,
  description,
  path,
  current,
  view,
  jsonld = [],
  og = '/og/home.png',
  noindex = false,
  preload = [],
} = Astro.props;
// The theme script runs inline before first paint; the security policy allows it by its hash only.
const themeHash = createHash('sha256').update(themeInit).digest('base64');
const csp = `default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-${themeHash}'; connect-src 'self'; font-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'`;
const other: Lang = lang === 'en' ? 'hi' : 'en';
const site = Astro.site as URL;
const abs = (l: Lang) => new URL(langPrefix(l) + path, site).href;
const mirror = langPrefix(other) + path;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={abs(lang)} />
    <link rel="alternate" hreflang="en" href={abs('en')} />
    <link rel="alternate" hreflang="hi" href={abs('hi')} />
    <link rel="alternate" hreflang="x-default" href={abs('en')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PakkaDSA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:image" content={new URL(og, site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'hi' ? 'hi_IN' : 'en_IN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(og, site).href} />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href={`${langPrefix(lang)}/manifest.webmanifest`} />
    <meta name="theme-color" content="#F7F8F4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#10152B" media="(prefers-color-scheme: dark)" />
    {jsonld.map((d) => (
      <script type="application/ld+json" set:html={ldJson(d)} />
    ))}
    <script is:inline set:html={themeInit} />
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {preload.map((f) => (
      <link rel="preload" href={`/fonts/${f}`} as="font" type="font/woff2" crossorigin />
    ))}
    <slot name="head" />
  </head>
  <body data-view={view} data-lang={lang} data-algo={current ?? ''}>
    <div class="app">
      <header class="top">
        <button
          class="tbtn menu-btn"
          id="menuBtn"
          aria-label={t(lang, 'openList')}
          aria-controls="side"
          aria-expanded="false"
        >
          <Icon name="menu" />
        </button>
        <a class="brand" href={homePath(lang)} id="home">
          <span class="mark" aria-hidden="true">
            P
          </span>
          <span>
            <b>PakkaDSA</b>
            <small>{t(lang, 'tag')}</small>
          </span>
        </a>
        <div class="tools" role="toolbar" aria-label={t(lang, 'mainActions')}>
          <a
            class="tbtn"
            id="langBtn"
            href={mirror}
            hreflang={other}
            lang={other}
            aria-label={`${t(lang, 'langName')} (${t(lang, 'switchLang')})`}
          >
            <Icon name="lang" />
            <span>
              <span class="lang-l">{t(lang, 'langName')}</span>
              <span class="lang-s">{t(lang, 'langShort')}</span>
            </span>
          </a>
          <button class="tbtn" id="quizBtn" aria-pressed="false" aria-label={t(lang, 'quiz')}>
            <Icon name="quiz" />
            <span class="lbl">{t(lang, 'quiz')}</span>
          </button>
          <button class="tbtn" id="shareBtn" aria-label={t(lang, 'share')}>
            <Icon name="share" />
            <span class="lbl">{t(lang, 'share')}</span>
          </button>
          <div class="menu-wrap">
            <button
              class="tbtn"
              id="moreBtn"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="moreMenu"
              aria-label={t(lang, 'more')}
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <circle cx="5" cy="12" r="1.8"></circle>
                <circle cx="12" cy="12" r="1.8"></circle>
                <circle cx="19" cy="12" r="1.8"></circle>
              </svg>
              <span class="lbl">{t(lang, 'more')}</span>
            </button>
            <div class="menu" id="moreMenu" role="menu" aria-label={t(lang, 'moreOptions')} hidden>
              <button class="mi" role="menuitemcheckbox" aria-checked="false" id="voiceBtn">
                <Icon name="voice" />
                <span>{t(lang, 'voice')}</span>
                <em class="st">{t(lang, 'off')}</em>
              </button>
              <button class="mi" role="menuitemcheckbox" aria-checked="false" id="classBtn">
                <Icon name="class" />
                <span>{t(lang, 'class')}</span>
                <em class="st">{t(lang, 'off')}</em>
              </button>
              <button class="mi" role="menuitemcheckbox" aria-checked="true" id="animBtn">
                <Icon name="anim" />
                <span>{t(lang, 'anim')}</span>
                <em class="st">{t(lang, 'on')}</em>
              </button>
              <button class="mi" role="menuitemcheckbox" aria-checked="false" id="themeBtn">
                <Icon name="dark" />
                <span>{t(lang, 'dark')}</span>
                <em class="st">{t(lang, 'off')}</em>
              </button>
              <button class="mi" role="menuitem" id="saveBtn" hidden={view !== 'viz'}>
                <Icon name="save" />
                <span>{t(lang, 'save')}</span>
              </button>
            </div>
          </div>
        </div>
      </header>
      <div class="body">
        <Sidebar lang={lang} current={current} />
        <main id="main">
          <slot />
          <Footer lang={lang} />
        </main>
      </div>
    </div>
    <div class="overlay" id="quiz" role="dialog" aria-modal="true" aria-labelledby="quizH">
      <div class="modal">
        <h2 id="quizH">{t(lang, 'predict')}</h2>
        <p class="q" id="quizQ"></p>
        <div class="opts" id="quizOpts"></div>
        <p class="fb" id="quizFb" aria-live="assertive"></p>
        <div class="row end">
          <button class="btn pri" id="quizGo" hidden>
            {t(lang, 'continue')}
          </button>
        </div>
      </div>
    </div>
    <div class="toast" id="toast" role="status"></div>
    <script>
      import '../app/main';
    </script>
  </body>
</html>
